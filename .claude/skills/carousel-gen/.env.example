# ============================================================
# GENERADOR PRINCIPAL: Google Gemini (Nano Banana 2 Lite)
# ============================================================
# 1. Crea/obtén tu API key en https://aistudio.google.com/apikey
# 2. Renombra este archivo a .env y pega tu key abajo
GEMINI_API_KEY=tu-api-key-aqui

GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
IMAGE_ASPECT_RATIO=4:5
IMAGE_SIZE=1K
ECONOMY_MODE=true
# FABRICA RAPIDA: modo normal SIEMPRE usa DIRECT MODE paralelo, nunca Batch (Batch puede
# tardar hasta 24h). Dejar en false — Batch queda solo para --force-batch explicito.
GEMINI_BATCH_ENABLED=false
MAX_SLIDES=10
# Presupuesto UNICO de reintentos (generacion + QA estructural + Text QA comparten el
# mismo contador): 1 = 1 intento inicial + 1 regeneracion maximo, solo por error CRITICO.
MAX_RETRIES=1
# Confirmado en https://ai.google.dev/gemini-api/docs/pricing (2026-09-16): ~$0.0336/imagen 1K
GEMINI_IMAGE_PRICE_PER_IMAGE=0.0336

# TEXT QA: OCR local (Tesseract) del texto renderizado en cada imagen vs exact_text.
# Requiere Tesseract-OCR instalado + `pip install pytesseract`; si no estan disponibles
# se omite automaticamente. OCR de baja confianza -> UNCERTAIN, nunca bloquea. Ver
# SKILL.md "TEXT QA".
TEXT_QA_ENABLED=true

# ============================================================
# PROVEEDORES LEGACY (desactivados por defecto)
# ============================================================
# Kie AI (Nano Banana 2, generador anterior a esta migracion economica)
KIE_AI_API_KEY=tu-api-key-aqui
KIE_ENABLED=false
FLOW_ENABLED=false
